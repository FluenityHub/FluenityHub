<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluenityHub_WinUIHost.Pages.LocationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Unloaded="OnPageUnloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Style of section headers -->
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,16,0,6" />
        </Style>

        <!-- Scale the BreadcrumbBar chevron separator to match TitleTextBlockStyle (28px) -->
        <x:Double x:Key="BreadcrumbBarChevronFontSize">20</x:Double>
        <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
        <Thickness x:Key="BreadcrumbBarChevronPadding">8,2,8,0</Thickness>

        <!-- Breadcrumb foreground brushes -->
        <SolidColorBrush x:Key="BreadcrumbBarForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="BreadcrumbBarHoverForegroundBrush" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="BreadcrumbBarPressedForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="BreadcrumbBarCurrentNormalForegroundBrush" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="BreadcrumbBarChevronForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="LocationsScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsVerticalScrollChainingEnabled="True"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <StackPanel Margin="36,24,36,24" Spacing="4">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <BreadcrumbBar
                    x:Name="SettingsBreadcrumbBar"
                    Margin="0,0,0,4"
                    AutomationProperties.Name="Settings navigation path"
                    ItemClicked="OnSettingsBreadcrumbItemClicked">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{Binding}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>

                <InfoBar
                    x:Name="StatusInfoBar"
                    Margin="0,-4,0,0"
                    Closed="OnStatusInfoBarClosed"
                    IsClosable="True"
                    IsOpen="False"
                    Visibility="Collapsed" />

                    <!-- Shared settings -->
                    <TextBlock
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="Shared settings" />

                    <controls:SettingsExpander
                        Description="Settings changed here are also used by Unity Hub"
                        Header="Unity Hub preferences"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}"
                        IsExpanded="True">
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                Description="New projects are saved here. Existing Unity projects directly inside the selected folder are imported into the shared Hub project list."
                                Header="Project location">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="UnityHubProjectLocationTextBox"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Unity Hub project location"
                                        IsReadOnly="True" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Choose Unity Hub project location"
                                        Click="OnChooseUnityHubProjectLocationClick"
                                        Content="Browse" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Reset Unity Hub project location"
                                        Click="OnResetUnityHubProjectLocationClick"
                                        Content="Reset"
                                        Style="{StaticResource SubtleButtonStyle}" />
                                </Grid>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                Description="Custom templates are saved here. Templates added by Unity Hub or FluenityHub are available to both."
                                Header="Templates location">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="UnityHubTemplatesLocationTextBox"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Unity Hub templates location"
                                        IsReadOnly="True" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Choose Unity Hub templates location"
                                        Click="OnChooseUnityHubTemplatesLocationClick"
                                        Content="Browse" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Reset Unity Hub templates location"
                                        Click="OnResetUnityHubTemplatesLocationClick"
                                        Content="Reset"
                                        Style="{StaticResource SubtleButtonStyle}" />
                                </Grid>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                Description="Choose a location for Editor and Learn installs. Existing installs are not affected."
                                Header="Installs location">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="UnityEditorInstallLocationTextBox"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Unity Editor install location"
                                        IsReadOnly="True" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Choose Unity Editor install location"
                                        Click="OnChooseUnityEditorInstallLocationClick"
                                        Content="Browse" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Reset Unity Editor install location"
                                        Click="OnResetUnityEditorInstallLocationClick"
                                        Content="Reset"
                                        Style="{StaticResource SubtleButtonStyle}" />
                                </Grid>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                Description="Choose Unity Hub's location for Editor and Learn downloads. Unity CLI manages its own download cache."
                                Header="Downloads location">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="UnityHubDownloadLocationTextBox"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Unity Hub download location"
                                        IsReadOnly="True" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Choose Unity Hub download location"
                                        Click="OnChooseUnityHubDownloadLocationClick"
                                        Content="Browse" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Reset Unity Hub download location"
                                        Click="OnResetUnityHubDownloadLocationClick"
                                        Content="Reset"
                                        Style="{StaticResource SubtleButtonStyle}" />
                                </Grid>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                Description="Choose the standard name shown for projects without a custom display name."
                                Header="Default project name">
                                <ComboBox
                                    x:Name="DefaultProjectNameComboBox"
                                    MinWidth="160"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Default Unity project name"
                                    SelectionChanged="OnDefaultProjectNameSelectionChanged">
                                    <ComboBoxItem Content="Folder name" Tag="FolderName" />
                                    <ComboBoxItem Content="Product name" Tag="ProductName" />
                                </ComboBox>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- Additional search paths -->
                    <TextBlock
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="Additional search paths" />

                    <controls:SettingsExpander
                        x:Name="CustomEditorPathsExpander"
                        Description="Specify additional directories to scan for custom Unity Editors"
                        Header="Custom editor search paths"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
                        <Button Click="OnAddCustomEditorPathClick" Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Add folder" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander
                        x:Name="CustomTemplatePathsExpander"
                        Description="Specify additional directories to scan for custom project templates"
                        Header="Custom template search paths"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
                        <Button
                            AutomationProperties.Name="Add custom template search path"
                            Click="OnAddCustomTemplatePathClick"
                            Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="Add folder" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
