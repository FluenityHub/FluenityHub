<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluenityHub_WinUIHost.Pages.LicensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluenityHub_WinUIHost.Models"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,16,0,6" />
        </Style>

        <!-- Scale the BreadcrumbBar chevron separator to match TitleTextBlockStyle (28px) -->
        <x:Double x:Key="BreadcrumbBarChevronFontSize">20</x:Double>
        <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
        <Thickness x:Key="BreadcrumbBarChevronPadding">8,2,8,0</Thickness>

        <!-- Previous breadcrumb items use secondary text; current item uses primary -->
        <SolidColorBrush x:Key="BreadcrumbBarForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="BreadcrumbBarHoverForegroundBrush" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="BreadcrumbBarPressedForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="BreadcrumbBarCurrentNormalForegroundBrush" Color="{ThemeResource TextFillColorPrimary}" />
        <SolidColorBrush x:Key="BreadcrumbBarChevronForegroundBrush" Color="{ThemeResource TextFillColorSecondary}" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="LicensesScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            IsVerticalScrollChainingEnabled="True"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <StackPanel Margin="36,24,36,24" Spacing="12">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <BreadcrumbBar
                    x:Name="SettingsBreadcrumbBar"
                    AutomationProperties.Name="Settings navigation path"
                    ItemClicked="OnSettingsBreadcrumbItemClicked">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{Binding}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RefreshButton"
                        AutomationProperties.Name="Refresh Unity licenses"
                        Click="OnRefreshClick"
                        Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing
                                x:Name="RefreshProgressRing"
                                Width="14"
                                Height="14"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;" />
                            <TextBlock x:Name="RefreshButtonText" Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="AddLicenseButton"
                        AutomationProperties.Name="Add new license"
                        Click="OnAddLicenseClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add license" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Unity account" />

            <StackPanel Spacing="2">
                <controls:SettingsCard x:Name="UnityAccountCard">
                    <controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PersonPicture
                                x:Name="UnityAccountPersonPicture"
                                Width="36"
                                Height="36"
                                AutomationProperties.Name="Unity account"
                                VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="UnityAccountNameTextBlock"
                                    IsTextSelectionEnabled="True"
                                    SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Unity ID" />
                                <TextBlock
                                    x:Name="UnityAccountEmailTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Checking Unity account session..." />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="UnitySignInButton"
                            AutomationProperties.Name="Sign in to Unity"
                            Click="OnUnitySignInClick"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ProgressRing
                                    x:Name="UnityAccountProgressRing"
                                    Width="14"
                                    Height="14"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <TextBlock x:Name="UnitySignInButtonText" Text="Sign in" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="UnitySignOutButton"
                            AutomationProperties.Name="Sign out of Unity"
                            Click="OnUnitySignOutClick"
                            Content="Sign out"
                            Style="{StaticResource SubtleButtonStyle}"
                            Visibility="Collapsed" />
                        <HyperlinkButton Click="OnManageUnityIdClick" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Manage account" />
                                <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Always open Unity Editor in offline mode, even when a Unity account is signed in. Online Unity services will be unavailable."
                    Header="Launch Editor in offline mode"
                    HeaderIcon="{ui:FontIcon Glyph=&#xF158;}">
                    <ToggleSwitch
                        x:Name="LaunchEditorInOfflineModeToggleSwitch"
                        AutomationProperties.AutomationId="LaunchEditorInOfflineModeToggleSwitch"
                        AutomationProperties.Name="Always launch Unity Editor in offline mode"
                        Toggled="OnLaunchEditorInOfflineModeToggled" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    x:Name="UnityOrganizationCard"
                    Click="OnManageOrganizationClick"
                    Description="View and manage Unity organizations, projects, and team subscriptions"
                    Header="Unity organization"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE716;}"
                    IsClickEnabled="True">
                    <controls:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
            </StackPanel>

            <InfoBar
                x:Name="UnityAccountInfoBar"
                Margin="0,-4,0,0"
                Closed="OnInfoBarClosed"
                IsClosable="True"
                IsOpen="False"
                Severity="Success"
                Visibility="Collapsed" />

            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="On this device" />

            <controls:SettingsExpander
                x:Name="LicenseExpander"
                Description="Checking license status"
                Header="License status"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8D7;}"
                IsExpanded="True">
                <TextBlock
                    x:Name="LicenseStatusTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Checking" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        x:Name="LicensingClientCard"
                        Header="Licensing client"
                        IsClickEnabled="False">
                        <controls:SettingsCard.Description>
                            <TextBlock
                                x:Name="LicensingClientPathTextBlock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Checking"
                                TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <TextBlock
                            x:Name="LicensingClientStatusTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Checking" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="LicenseTypeCard"
                        Header="License type"
                        IsClickEnabled="False"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="LicenseTypeTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        x:Name="LicenseDetailsCard"
                        Header="Details"
                        IsClickEnabled="False"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="LicenseDetailsTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            SelectionHighlightColor="{ThemeResource TextControlSelectionHighlightColor}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <InfoBar
                x:Name="StatusInfoBar"
                Margin="0,-4,0,0"
                Closed="OnInfoBarClosed"
                IsClosable="True"
                IsOpen="False"
                Severity="Success"
                Visibility="Collapsed" />

            <StackPanel
                x:Name="LoadingPanel"
                Margin="0,24"
                HorizontalAlignment="Center"
                Spacing="8">
                <ProgressRing
                    Width="28"
                    Height="28"
                    IsActive="True" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Reading Unity licenses…" />
            </StackPanel>

            <StackPanel
                x:Name="EmptyStatePanel"
                Margin="0,24"
                HorizontalAlignment="Center"
                Spacing="6"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8D7;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No active licenses found" />
                <TextBlock
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Manage your Unity ID account, then select Refresh to synchronize licenses for this Windows user."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <HyperlinkButton
                HorizontalAlignment="Left"
                Click="OnLearnAboutLicensesClick"
                Content="Learn about Unity licenses" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
