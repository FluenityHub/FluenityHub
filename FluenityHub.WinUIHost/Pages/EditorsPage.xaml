<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluenityHub_WinUIHost.Pages.EditorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluenityHub_WinUIHost.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluenityHub_WinUIHost.Models"
    xmlns:services="using:FluenityHub_WinUIHost.Services"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="PageScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        IsTabStop="True"
        VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,24,36,24" Padding="0">
            <Grid.ChildrenTransitions>
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </Grid.ChildrenTransitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page Header Title -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,16"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Installs" />

            <!-- Command & Search Header Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Group: Search & Refresh -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="240"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search installed editors"
                        PlaceholderText="Search installed editors..."
                        QueryIcon="Find"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        UpdateTextOnSelect="False" />

                    <Button
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Refresh installed editors list"
                        Click="OnRefreshClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Refresh installed editors list (Ctrl+R)">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>

                <!-- Right Group: Locate & Sort Mode -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Locate existing Unity editor"
                        Click="OnLocateEditorClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Locate installed Unity Editor folder on disk">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock Text="Locate" />
                        </StackPanel>
                    </Button>

                    <Button
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Install Unity Editor"
                        Click="OnInstallEditorClick"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Browse and install Unity Editor releases">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE896;" />
                            <TextBlock Text="Install Editor" />
                        </StackPanel>
                    </Button>

                    <DropDownButton
                        x:Name="SortDropDownButton"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Sort installed editors"
                        ToolTipService.ToolTip="Sort installed editors">
                        <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem
                                    x:Name="SortNewestItem"
                                    Click="OnSortOptionClick"
                                    GroupName="EditorSortGroup"
                                    IsChecked="True"
                                    Text="Version (Newest first)" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortOldestItem"
                                    Click="OnSortOptionClick"
                                    GroupName="EditorSortGroup"
                                    Text="Version (Oldest first)" />
                                <RadioMenuFlyoutItem
                                    x:Name="SortDirectoryItem"
                                    Click="OnSortOptionClick"
                                    GroupName="EditorSortGroup"
                                    Text="Directory (A to Z)" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>

        <!-- Top Floating Overlay InfoBar (does not push page content) -->
        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="0"
            Grid.RowSpan="5"
            Margin="0,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Canvas.ZIndex="99"
            IsClosable="True"
            IsOpen="False" />

            <!-- Background Downloads & Installs Expander & Status InfoBar -->
            <StackPanel
                Grid.Row="2"
                Margin="0,0,0,12"
                Spacing="8"
                Visibility="{x:Bind DownloadsExpander.Visibility, Mode=OneWay}">
                <controls:SettingsExpander
                    x:Name="DownloadsExpander"
                    Margin="0,0,0,0"
                    AutomationProperties.Name="Downloads and installs"
                    Description="Background installations appear here"
                    Header="Downloads and installs"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE896;}"
                    IsExpanded="False"
                    ItemsSource="{x:Bind ModuleOperations, Mode=OneWay}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel
                            Width="220"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="DownloadsSummaryTextBlock"
                                    AutomationProperties.LiveSetting="Polite"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Preparing"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="DownloadsSummaryPercentageTextBlock"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Visibility="Collapsed" />
                            </Grid>
                            <ProgressBar
                                x:Name="DownloadsSummaryProgressBar"
                                AutomationProperties.Name="Overall module installation progress"
                                Maximum="100"
                                Minimum="0" />
                        </StackPanel>
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Download and install options"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="More download and install options">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem
                                        x:Name="ClearInactiveInstallsMenuItem"
                                        Click="OnClearInactiveModuleOperationsClick"
                                        Text="Clear canceled and failed">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <controls:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="models:UnityModuleInstallationListItem">
                            <controls:SettingsCard
                                Padding="0"
                                ContentAlignment="Vertical"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                IsActionIconVisible="False">
                                <Expander
                                    AutomationProperties.Name="{x:Bind EditorVersion, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="False">
                                    <Expander.Header>
                                        <Grid
                                            MinHeight="64"
                                            Padding="12,6,0,6"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ImageIcon
                                                Width="24"
                                                Height="24"
                                                VerticalAlignment="Center"
                                                Source="{x:Bind IconPath, Mode=OneWay}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind EditorVersion, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Details, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="0,0,-14,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <Button
                                                    AutomationProperties.Name="{x:Bind RetryAutomationName, Mode=OneWay}"
                                                    Click="OnRetryModuleOperationClick"
                                                    Content="{x:Bind RetryText, Mode=OneWay}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Tag="{x:Bind Id, Mode=OneWay}"
                                                    Visibility="{x:Bind RetryActionVisibility, Mode=OneWay}" />
                                                <Button
                                                    AutomationProperties.Name="{x:Bind ResumeAutomationName, Mode=OneWay}"
                                                    Click="OnResumeModuleOperationClick"
                                                    Content="Resume"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Tag="{x:Bind Id, Mode=OneWay}"
                                                    Visibility="{x:Bind ResumeActionVisibility, Mode=OneWay}" />
                                                <Button
                                                    MinWidth="72"
                                                    AutomationProperties.Name="{x:Bind PauseAutomationName, Mode=OneWay}"
                                                    Click="OnPauseModuleOperationClick"
                                                    Content="{x:Bind PauseText, Mode=OneWay}"
                                                    IsEnabled="{x:Bind CanPause, Mode=OneWay}"
                                                    Tag="{x:Bind Id, Mode=OneWay}"
                                                    Visibility="{x:Bind PauseActionVisibility, Mode=OneWay}" />
                                                <Button
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    AutomationProperties.Name="More installation options"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    ToolTipService.ToolTip="More installation options"
                                                    Visibility="{x:Bind MoreActionsVisibility, Mode=OneWay}">
                                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuFlyoutItem
                                                                AutomationProperties.Name="{x:Bind CancelAutomationName, Mode=OneWay}"
                                                                Click="OnCancelModuleOperationClick"
                                                                IsEnabled="{x:Bind CanCancel, Mode=OneWay}"
                                                                Tag="{x:Bind Id, Mode=OneWay}"
                                                                Text="Cancel installation"
                                                                Visibility="{x:Bind CancelVisibility, Mode=OneWay}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE711;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutSeparator Visibility="{x:Bind CancelSeparatorVisibility, Mode=OneWay}" />
                                                            <MenuFlyoutItem
                                                                AutomationProperties.Name="{x:Bind OpenLogAutomationName, Mode=OneWay}"
                                                                Click="OnOpenModuleLogClick"
                                                                Tag="{x:Bind LogFilePath, Mode=OneWay}"
                                                                Text="Open download log"
                                                                Visibility="{x:Bind OpenLogVisibility, Mode=OneWay}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xF000;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                            <MenuFlyoutItem
                                                                AutomationProperties.Name="{x:Bind OpenLogFolderAutomationName, Mode=OneWay}"
                                                                Click="OnOpenModuleLogFolderClick"
                                                                Tag="{x:Bind LogFilePath, Mode=OneWay}"
                                                                Text="Open in File Explorer"
                                                                Visibility="{x:Bind OpenLogVisibility, Mode=OneWay}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE8B7;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel Padding="12,8,12,12" Spacing="8">
                                        <InfoBar
                                            IsClosable="False"
                                            IsIconVisible="True"
                                            IsOpen="{x:Bind IsErrorOpen, Mode=OneWay}"
                                            Message="{x:Bind ErrorDetails, Mode=OneWay}"
                                            Severity="Error"
                                            Title="Installation failed" />

                                        <ItemsRepeater ItemsSource="{x:Bind Modules, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="4" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="models:UnityModuleProgressListItem">
                                                    <controls:SettingsCard
                                                        Description="{x:Bind Details, Mode=OneWay}"
                                                        Header="{x:Bind Name, Mode=OneWay}"
                                                        IsActionIconVisible="False">
                                                        <StackPanel
                                                            Width="260"
                                                            VerticalAlignment="Center"
                                                            Spacing="2">
                                                            <Grid
                                                                AutomationProperties.LiveSetting="Polite"
                                                                AutomationProperties.Name="{x:Bind StatusAutomationName, Mode=OneWay}"
                                                                ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon
                                                                    FontSize="14"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Glyph="{x:Bind StatusGlyph, Mode=OneWay}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind DisplayPhase, Mode=OneWay}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <ProgressBar
                                                                AutomationProperties.Name="{x:Bind ProgressAutomationName, Mode=OneWay}"
                                                                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                                Maximum="100"
                                                                Minimum="0"
                                                                ShowError="{x:Bind ShowError, Mode=OneWay}"
                                                                ShowPaused="{x:Bind ShowPaused, Mode=OneWay}"
                                                                Value="{x:Bind Percentage, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </controls:SettingsCard>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Expander>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </controls:SettingsExpander.ItemTemplate>
                </controls:SettingsExpander>

                <InfoBar
                    x:Name="DownloadsInfoBar"
                    IsClosable="True"
                    IsOpen="False" />
            </StackPanel>

        <!-- Count Summary -->
        <TextBlock
            x:Name="SummaryTextBlock"
            Grid.Row="3"
            Margin="0,0,0,12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}" />

        <!-- Installed Editors List -->
        <Grid Grid.Row="4" MinHeight="160">
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                Spacing="8"
                Visibility="Collapsed">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Loading installed editors"
                    IsActive="False" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Loading installed editors..." />
            </StackPanel>
            <ItemsRepeater x:Name="EditorsListView">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:EditorListItem">
                        <controls:SettingsCard RightTapped="OnItemRightTapped">
                            <controls:SettingsCard.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnContextLaunchEditorClick"
                                        IsEnabled="{x:Bind CanUseEditor, Mode=OneTime}"
                                        Tag="{x:Bind Editor, Mode=OneTime}"
                                        Text="Launch Unity Editor">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Click="OnAddModulesClick"
                                        IsEnabled="{x:Bind CanUseEditor, Mode=OneTime}"
                                        Tag="{x:Bind Editor, Mode=OneTime}"
                                        Text="Add modules">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE710;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem Click="OnVerifyIntegrityClick" Text="Verify &amp; repair installation..." Tag="{x:Bind Editor, Mode=OneTime}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE90F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnResetSandboxClick" Text="Reset Sandbox workspace" Tag="{x:Bind Editor, Mode=OneTime}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE777;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem Click="OnContextOpenFolderClick" Text="Open in File Explorer" Tag="{x:Bind Editor, Mode=OneTime}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnContextReleaseNotesClick" Text="View release notes" Tag="{x:Bind Editor, Mode=OneTime}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xF000;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        Click="OnUninstallEditorClick"
                                        IsEnabled="{x:Bind CanUseEditor, Mode=OneTime}"
                                        Tag="{x:Bind Editor, Mode=OneTime}"
                                        Text="Uninstall">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </controls:SettingsCard.ContextFlyout>
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon Source="{x:Bind Editor.IconPath, Mode=OneTime}" Width="40" Height="40" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Header>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <!-- Title Row + Badges (Inline matching ProjectsPage layout) -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Editor.DisplayName, Mode=OneTime}"
                                            VerticalAlignment="Center" />

                                        <!-- Installed Target Platform Badges -->
                                        <ItemsControl ItemsSource="{x:Bind TargetPlatforms, Mode=OneTime}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:TargetPlatformInfo">
                                                    <Border
                                                        Height="20"
                                                        Padding="6,0"
                                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneTime}"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                                        ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneTime}"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind DisplayName, Mode=OneTime}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Project Usage Count Badge Pill -->
                                        <Button
                                            Height="20"
                                            Padding="6,0"
                                            AutomationProperties.Name="{x:Bind ProjectCountTooltip, Mode=OneTime}"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Click="OnProjectCountBadgeClick"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Tag="{x:Bind Editor.Version, Mode=OneTime}"
                                            ToolTipService.ToolTip="{x:Bind ProjectCountTooltip, Mode=OneTime}"
                                            VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <FontIcon FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8B9;" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ProjectCountLabel, Mode=OneTime}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Directory Path Subtitle -->
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Editor.InstallDirectory, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    Height="32"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Launch blank Unity editor"
                                    Click="OnLaunchEditorClick"
                                    IsEnabled="{x:Bind CanUseEditor, Mode=OneTime}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Tag="{x:Bind Editor, Mode=OneTime}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            AutomationProperties.Name="Uninstalling Unity Editor"
                                            IsActive="{x:Bind IsUninstalling, Mode=OneTime}"
                                            Visibility="{x:Bind UninstallProgressVisibility, Mode=OneTime}" />
                                        <FontIcon
                                            FontSize="14"
                                            Glyph="&#xE768;"
                                            Visibility="{x:Bind LaunchIconVisibility, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind LaunchButtonText, Mode=OneTime}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="More options"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="More options">
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem
                                                Click="OnAddModulesClick"
                                                IsEnabled="{x:Bind CanUseEditor, Mode=OneTime}"
                                                Tag="{x:Bind Editor, Mode=OneTime}"
                                                Text="Add modules">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE710;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Click="OnViewAssociatedProjectsClick"
                                                Tag="{x:Bind Editor.Version, Mode=OneTime}"
                                                Text="View associated projects">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B9;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutSeparator />

                                            <MenuFlyoutItem Click="OnVerifyIntegrityClick" Text="Verify &amp; repair installation..." Tag="{x:Bind Editor, Mode=OneTime}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE90F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OnResetSandboxClick" Text="Reset Sandbox workspace" Tag="{x:Bind Editor, Mode=OneTime}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE777;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutSeparator />

                                            <MenuFlyoutItem Click="OnOpenFolderClick" Text="Open in File Explorer" Tag="{x:Bind Editor.InstallDirectory, Mode=OneTime}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OnViewReleaseNotesClick" Text="View release notes" Tag="{x:Bind Editor.Version, Mode=OneTime}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xF000;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Click="OnUninstallEditorClick"
                                                IsEnabled="{x:Bind CanUseEditor, Mode=OneTime}"
                                                Tag="{x:Bind Editor, Mode=OneTime}"
                                                Text="Uninstall">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Empty State Display -->
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xEC05;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No Unity Editors detected" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Install Unity Editor via Unity Hub or locate an existing Editor installation on disk." />
                <Button
                    Height="32"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Locate existing Unity editor"
                    Click="OnLocateEditorClick"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                        <TextBlock Text="Locate editor" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
