<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluenityHub_WinUIHost.Dialogs.OfflineInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    Title="Offline &amp; Manual Installation Recovery"
    CloseButtonText="Close"
    DefaultButton="Close"
    PrimaryButtonText="Install / Repair"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <Storyboard x:Name="CopyButtonPulseAnimation">
            <DoubleAnimation
                Storyboard.TargetName="CopyIconScaleTransform"
                Storyboard.TargetProperty="ScaleX"
                From="1.0"
                To="1.35"
                AutoReverse="True"
                Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CopyIconScaleTransform"
                Storyboard.TargetProperty="ScaleY"
                From="1.0"
                To="1.35"
                AutoReverse="True"
                Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </ContentDialog.Resources>

    <Grid MinWidth="480" MaxWidth="560" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Subtitle Info -->
        <TextBlock
            Grid.Row="0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Install Unity Editor or target platform modules from local offline setup files without downloading."
            TextWrapping="Wrap" />

        <!-- Card 1: Package Picker -->
        <controls:SettingsCard
            Grid.Row="1"
            Description="Select UnitySetup.exe, component installer (.exe/.msi), or Download Assistant (.json)"
            Header="Installer package"
            HeaderIcon="{ui:FontIcon Glyph=&#xE7B8;}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="InstallerPathTextBox"
                    Width="220"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Offline installer path"
                    IsReadOnly="True"
                    PlaceholderText="No file selected..." />
                <Button
                    AutomationProperties.Name="Browse for offline installer package"
                    Click="OnBrowseInstallerClick"
                    Content="Browse" />
            </StackPanel>
        </controls:SettingsCard>

        <!-- Card 2: Target Location -->
        <controls:SettingsCard
            Grid.Row="2"
            Description="Target Unity Editor folder to repair or install components into"
            Header="Target installation path"
            HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox
                    x:Name="TargetLocationTextBox"
                    Width="220"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Target installation path"
                    IsReadOnly="True"
                    PlaceholderText="Select installation location..." />
                <Button
                    AutomationProperties.Name="Browse for target installation location"
                    Click="OnBrowseTargetLocationClick"
                    Content="Browse" />
            </StackPanel>
        </controls:SettingsCard>

        <!-- Output Log & Status Section -->
        <Grid Grid.Row="3" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status InfoBar -->
            <InfoBar
                x:Name="StatusInfoBar"
                Grid.Row="0"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational" />

            <!-- Log Header & Copy Button -->
            <Grid Grid.Row="1">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Installation logs" />
                <Button
                    x:Name="CopyLogButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Copy offline installation log details"
                    Click="OnCopyLogsClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Copy log to clipboard">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon
                            x:Name="CopyLogFontIcon"
                            FontSize="12"
                            Glyph="&#xE8C8;"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform x:Name="CopyIconScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <TextBlock
                            x:Name="CopyLogTextBlock"
                            FontSize="12"
                            Text="Copy log" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Diagnostic Log Output Box -->
            <Border
                Grid.Row="2"
                MaxHeight="160"
                Padding="10"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <RichTextBlock
                        x:Name="LogsRichTextBlock"
                        FontFamily="Consolas, Segoe UI"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
