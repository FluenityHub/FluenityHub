<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluenityHub_WinUIHost.Dialogs.ProjectBackupsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluenityHub_WinUIHost.Models"
    CloseButtonText="Close"
    Closed="OnDialogClosed"
    DefaultButton="Close"
    HorizontalContentAlignment="Stretch"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="BackupsListView"
            AutomationProperties.AutomationId="ProjectBackupsList"
            MinWidth="500"
            SelectionMode="None"
            Visibility="Collapsed">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ProjectBackupRecord">
                    <controls:SettingsCard Header="{x:Bind CreatedAtDisplay}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE753;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind DetailsDisplay}" />
                                <TextBlock
                                    MaxLines="1"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind LocationDisplay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind BackupPath}" />
                            </StackPanel>
                        </controls:SettingsCard.Description>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                AutomationProperties.Name="Restore backup as a new project"
                                Click="OnRestoreBackupClick"
                                Content="Restore"
                                Height="32"
                                IsEnabled="{x:Bind IsAvailable}"
                                Tag="{x:Bind}" />
                            <Button
                                AutomationProperties.Name="More backup actions"
                                Height="32"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="More options">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem
                                            Click="OnOpenBackupClick"
                                            IsEnabled="{x:Bind IsAvailable}"
                                            Tag="{x:Bind}"
                                            Text="Open backup folder">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Click="OnDeleteBackupClick"
                                            Tag="{x:Bind}"
                                            Text="{x:Bind DeleteActionText}">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid
            x:Name="LoadingStatePanel"
            Padding="36,28"
            AutomationProperties.AutomationId="ProjectBackupsLoading">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Loading project backups"
                    IsActive="True" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Loading backups..." />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="EmptyStatePanel"
            Padding="36,28"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE753;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No backups yet" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Create a backup from the project's context menu."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ErrorStatePanel"
            Padding="0,8"
            Visibility="Collapsed">
            <InfoBar
                x:Name="LoadErrorInfoBar"
                VerticalAlignment="Center"
                IsClosable="False"
                IsOpen="True"
                Severity="Error"
                Title="Couldn't load backups">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.AutomationId="RetryLoadProjectBackups"
                        Click="OnRetryLoadClick"
                        Content="Retry" />
                </InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</ContentDialog>
