<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluenityHub_WinUIHost.Dialogs.ManageProjectTagsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:custom="using:FluenityHub_WinUIHost.Controls"
    xmlns:dialogs="using:FluenityHub_WinUIHost.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Manage Project Tags"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TagDropIndicatorBrush" Color="#FF000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TagDropIndicatorBrush" Color="#FFFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TagDropIndicatorBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
            <Flyout x:Name="RenameTagFlyout" Placement="Bottom" Opened="OnRenameTagFlyoutOpened">
                <StackPanel Width="230" Spacing="12">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Rename Tag" />
                    <TextBox
                        x:Name="RenameTagTextBox"
                        Header="Tag name"
                        MaxLength="24"
                        AutomationProperties.Name="New tag name input"
                        KeyDown="OnRenameTagKeyDown"
                        PlaceholderText="Type tag name..." />
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Click="OnCancelRenameTagClick"
                            Content="Cancel"
                            Style="{StaticResource SubtleButtonStyle}" />
                        <Button
                            Click="OnSaveRenameTagClick"
                            Content="Save"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel Width="460" Spacing="16">
        <!-- Subtitle & Identity -->
        <TextBlock
            x:Name="SubtitleTextBlock"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Select or create custom tags to organize your projects." />

        <!-- Inline Feedback Status -->
        <InfoBar
            x:Name="DialogInfoBar"
            IsClosable="True"
            IsOpen="False" />

        <!-- Add Custom Tag Input Group -->
        <StackPanel Spacing="6">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Add custom tag" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="NewTagTextBox"
                    MaxLength="24"
                    AutomationProperties.Name="Custom tag name input"
                    KeyDown="OnNewTagKeyDown"
                    PlaceholderText="Type a tag name (e.g., Game, Client Project, 2D)..." />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Add tag"
                    Click="OnAddTagClick"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Add custom tag to project">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock Text="Add Tag" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Color Dot Palette & Custom Color Picker -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Color:"
                    Margin="0,0,2,0" />
                <StackPanel x:Name="PresetColorDotsPanel" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="ColorBlueBtn" Click="OnColorDotClick" Tag="Blue" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" ToolTipService.ToolTip="Blue" AutomationProperties.Name="Blue color">
                        <Ellipse Width="14" Height="14" Fill="#0078D4" />
                    </Button>
                    <Button x:Name="ColorTealBtn" Click="OnColorDotClick" Tag="Teal" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" ToolTipService.ToolTip="Teal" AutomationProperties.Name="Teal color">
                        <Ellipse Width="14" Height="14" Fill="#008272" />
                    </Button>
                    <Button x:Name="ColorGreenBtn" Click="OnColorDotClick" Tag="Green" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" ToolTipService.ToolTip="Green" AutomationProperties.Name="Green color">
                        <Ellipse Width="14" Height="14" Fill="#107C41" />
                    </Button>
                    <Button x:Name="ColorYellowBtn" Click="OnColorDotClick" Tag="Yellow" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" ToolTipService.ToolTip="Yellow" AutomationProperties.Name="Yellow color">
                        <Ellipse Width="14" Height="14" Fill="#D8A000" />
                    </Button>
                    <Button x:Name="ColorOrangeBtn" Click="OnColorDotClick" Tag="Orange" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" ToolTipService.ToolTip="Orange" AutomationProperties.Name="Orange color">
                        <Ellipse Width="14" Height="14" Fill="#DA3B01" />
                    </Button>
                    <Button x:Name="ColorRedBtn" Click="OnColorDotClick" Tag="Red" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" ToolTipService.ToolTip="Red" AutomationProperties.Name="Red color">
                        <Ellipse Width="14" Height="14" Fill="#E81123" />
                    </Button>
                    <Button x:Name="ColorPurpleBtn" Click="OnColorDotClick" Tag="Purple" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" ToolTipService.ToolTip="Purple" AutomationProperties.Name="Purple color">
                        <Ellipse Width="14" Height="14" Fill="#8764B8" />
                    </Button>
                    <Button x:Name="ColorPinkBtn" Click="OnColorDotClick" Tag="Pink" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" ToolTipService.ToolTip="Pink" AutomationProperties.Name="Pink color">
                        <Ellipse Width="14" Height="14" Fill="#E3008C" />
                    </Button>
                </StackPanel>

                <!-- Custom Preview Dot (visible when custom hex is active) -->
                <Button
                    x:Name="CustomColorPreviewBtn"
                    Width="24"
                    Height="24"
                    MinWidth="24"
                    MinHeight="24"
                    Padding="0"
                    Click="OnColorDotClick"
                    Tag=""
                    CornerRadius="12"
                    BorderThickness="2"
                    BorderBrush="Transparent"
                    Background="Transparent"
                    AutomationProperties.Name="Custom color preview"
                    ToolTipService.ToolTip="Active custom color"
                    Visibility="Collapsed">
                    <Ellipse x:Name="CustomColorPreviewDot" Width="14" Height="14" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                </Button>

                <!-- Custom Color Picker Launcher -->
                <Button
                    x:Name="CustomColorButton"
                    Height="24"
                    Padding="8,0"
                    AutomationProperties.Name="Custom color picker"
                    Click="OnOpenNewTagColorPickerClick"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Choose custom color...">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="10" Glyph="&#xE790;" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Custom..." />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="CustomColorFlyout" Placement="Bottom">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Custom Tag Color" />
                                <controls:ColorPicker
                                    x:Name="TagColorPicker"
                                    IsAlphaEnabled="False"
                                    IsColorChannelTextInputVisible="True"
                                    IsColorPaletteVisible="True"
                                    IsColorSliderVisible="True"
                                    IsColorSpectrumVisible="True"
                                    IsHexInputVisible="True"
                                    IsMoreButtonVisible="False"
                                    ShowAccentColors="True" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Click="OnCloseCustomColorClick"
                                        Content="Close" />
                                    <Button
                                        Click="OnApplyCustomColorClick"
                                        Content="Apply"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Suggested / Available Tags -->
        <StackPanel Spacing="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Available categories:" />
                <Button
                    x:Name="ResetCategoriesButton"
                    Grid.Column="1"
                    Padding="6,2"
                    AutomationProperties.Name="Reset available categories to default presets"
                    Click="OnResetCategoriesClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Restore default category presets">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="10" Glyph="&#xE72C;" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Reset categories" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid>
                <ItemsControl
                    x:Name="AvailableTagsItemsControl"
                    AllowDrop="True"
                    AutomationProperties.HelpText="Drag categories to change their order."
                    AutomationProperties.Name="Available categories"
                    DragLeave="OnTagCollectionDragLeave"
                    DragOver="OnAvailableTagsDragOver"
                    Drop="OnAvailableTagsDrop">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <custom:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:TagChipItem">
                            <ToggleButton
                                Height="28"
                                Padding="8,0,4,0"
                                AutomationProperties.Name="{x:Bind Name}"
                                CanDrag="True"
                                Click="OnTagChipToggleClick"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                DragStarting="OnAvailableTagDragStarting"
                                DropCompleted="OnTagDropCompleted"
                                Loaded="OnTagToggleButtonLoaded"
                                Tag="{x:Bind Name}"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind ColorBrush, Mode=OneTime}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        MaxWidth="140"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Width="18"
                                        Height="18"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Delete category"
                                        Click="OnDeleteAvailableTagClick"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Tag="{x:Bind Name}"
                                        ToolTipService.ToolTip="Delete category">
                                        <FontIcon FontSize="8" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas IsHitTestVisible="False">
                    <Border
                        x:Name="AvailableTagDropIndicator"
                        Width="1"
                        Height="28"
                        Background="{ThemeResource TagDropIndicatorBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </StackPanel>

        <!-- Active Tags Card Section -->
        <Border
            Padding="12,10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Active Tags" />
                    <Button
                        x:Name="ClearAllTagsButton"
                        Grid.Column="1"
                        Padding="6,2"
                        AutomationProperties.Name="Clear all active tags"
                        Click="OnClearAllTagsClick"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Remove all tags from project">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="10" Glyph="&#xE74D;" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Clear all" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="EmptyTagsTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="No tags assigned to this project yet."
                    Visibility="Collapsed" />

                <Grid>
                    <ItemsControl
                        x:Name="ActiveTagsItemsControl"
                        AllowDrop="True"
                        AutomationProperties.HelpText="Drag active tags to change their order."
                        AutomationProperties.Name="Active tags"
                        DragLeave="OnTagCollectionDragLeave"
                        DragOver="OnActiveTagsDragOver"
                        Drop="OnActiveTagsDrop">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <custom:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dialogs:TagChipItem">
                                <Border
                                    Height="26"
                                    Padding="8,2"
                                    CanDrag="True"
                                    Background="{x:Bind TintBrush, Mode=OneTime}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    DragStarting="OnActiveTagDragStarting"
                                    DropCompleted="OnTagDropCompleted"
                                    Loaded="OnActiveTagBorderLoaded"
                                    Tag="{x:Bind Name}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            Fill="{x:Bind ColorBrush, Mode=OneTime}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            MaxWidth="150"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Width="16"
                                            Height="16"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Clear tag"
                                            Click="OnRemoveTagClick"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Tag="{x:Bind Name}"
                                            ToolTipService.ToolTip="Clear tag">
                                            <FontIcon FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE711;" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Canvas IsHitTestVisible="False">
                        <Border
                            x:Name="ActiveTagDropIndicator"
                            Width="1"
                            Height="26"
                            Background="{ThemeResource TagDropIndicatorBrush}"
                            CornerRadius="2"
                            Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
