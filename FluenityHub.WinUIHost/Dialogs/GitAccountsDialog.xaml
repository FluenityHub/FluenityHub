<ContentDialog
    x:Class="FluenityHub_WinUIHost.Dialogs.GitAccountsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Git accounts" CloseButtonText="Close"
    Style="{StaticResource DefaultContentDialogStyle}">
    <StackPanel MinWidth="420" Spacing="16">
        <TextBlock Text="Sign in with Git Credential Manager. Credentials stay in its secure storage."
                   TextWrapping="Wrap" />
        <ComboBox x:Name="ProviderBox" Header="Provider" SelectedIndex="0" HorizontalAlignment="Stretch" AutomationProperties.Name="Git provider">
            <ComboBoxItem Content="GitHub" Tag="github" />
            <ComboBoxItem Content="GitLab" Tag="gitlab" />
        </ComboBox>
        <TextBox x:Name="ScopeBox" Header="Organization or organization/repository (optional)" AutomationProperties.Name="Git account scope" />
        <TextBox x:Name="UserBox" Header="Account name (optional)" AutomationProperties.Name="Preferred Git account" />
        <TextBlock Text="Leave the scope empty to use this account by default. More specific repository choices take precedence over organization choices."
                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SignInButton" Content="Sign in with browser" Click="OnSignIn" AutomationProperties.Name="Sign in to Git with browser" />
            <Button x:Name="SaveButton" Content="Save account choice" Click="OnSave" AutomationProperties.Name="Save preferred Git account" />
        </StackPanel>
        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
    </StackPanel>
</ContentDialog>
