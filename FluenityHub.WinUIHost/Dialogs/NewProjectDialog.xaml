<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="FluenityHub_WinUIHost.Dialogs.NewProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluenityHub_WinUIHost.Controls"
    Title="Create a new project"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonText="Cancel"
    Closed="OnClosed"
    Closing="OnClosing"
    Loaded="OnLoaded"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Create"
    Style="{StaticResource DefaultContentDialogStyle}">
    <Grid MinWidth="480" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="LoadingPanel" Margin="24" HorizontalAlignment="Center" Spacing="12">
            <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="True" AutomationProperties.Name="Finding Unity Editors" />
            <TextBlock Text="Finding Unity Editors..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <InfoBar x:Name="EditorErrorInfoBar" IsClosable="False" IsOpen="False" Severity="Warning" />
        <controls:NewProjectForm x:Name="ProjectForm" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</ContentDialog>
